# Copy to .env.local and fill from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: extra gate for /coach (comma-separated). Still requires profiles.role = 'coach'.
# COACH_EMAILS=you@example.com

# Optional: used later for server admin tasks (never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
