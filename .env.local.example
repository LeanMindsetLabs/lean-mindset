# Lean Mindset Lab — copy to .env.local (gitignored). Do not reuse on other projects.

ACTIVE_PROJECT=lean-mindset

# Canonical production URL (custom domain)
NEXT_PUBLIC_SITE_URL=https://www.leanmindset.app

# Supabase (project ref: fdsccpcapzgzyxnuweit)
NEXT_PUBLIC_SUPABASE_URL=https://fdsccpcapzgzyxnuweit.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_from_supabase_dashboard

# Coach gate for /coach middleware (comma-separated). User must have profiles.role = coach.
COACH_EMAILS=LeanMindsetLabs@gmail.com

# Project scope markers (optional; helps scripts/agents stay on this product only)
LEAN_MINDSET_OWNER_EMAIL=LeanMindsetLabs@gmail.com
LEAN_MINDSET_GITHUB_ORG=LeanMindsetLabs
LEAN_MINDSET_GITHUB_REPO=lean-mindset
LEAN_MINDSET_VERCEL_TEAM=lean-mindset-labs
LEAN_MINDSET_VERCEL_PROJECT=leanmindset
LEAN_MINDSET_SUPABASE_REF=fdsccpcapzgzyxnuweit

# After `gh auth login` with LeanMindsetLabs Google SSO, set your GitHub username (not org name):
# LEAN_MINDSET_GITHUB_CLI_USER=your_github_username

# One-time domain deploy script (`npm run configure:domain`) — never commit real tokens
# SUPABASE_ACCESS_TOKEN=sbp_...   # https://supabase.com/dashboard/account/tokens
# VERCEL_TOKEN=...                # https://vercel.com/account/tokens (LeanMindsetLabs team)

# Optional: server admin only — never expose to client or commit real values
# SUPABASE_SERVICE_ROLE_KEY=

# Auth passwords: set only in Supabase Dashboard → Authentication → Users.
# GitHub / Vercel / Supabase dashboards: Google SSO as LeanMindsetLabs@gmail.com.

# App Store Connect API (Identifier + app via `npm run asc:create-app`)
# Create key: ASC → Users and Access → Integrations → App Store Connect API (Admin).
# Never commit AuthKey_*.p8 or real values. See docs/IOS_TESTFLIGHT.md.
# APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
# APP_STORE_CONNECT_API_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8
# APP_STORE_CONNECT_PRIVATE_KEY=   # optional PEM alternative to path — do not commit
